<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">


	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>bdd-xslt</ToolCommandName>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OoBDev.CodeAnalysis.DacFx\OoBDev.CodeAnalysis.DacFx.csproj" />
		<ProjectReference Include="..\OoBDev.CodeAnalysis.StructuredLog\OoBDev.CodeAnalysis.StructuredLog.csproj" />
		<ProjectReference Include="..\OoBDev.CodeAnalysis\OoBDev.CodeAnalysis.csproj" />
		<ProjectReference Include="..\OoBDev.Templating.Html\OoBDev.Templating.Html.csproj" />
		<ProjectReference Include="..\OoBDev.TestUtilities\OoBDev.TestUtilities.csproj" />
		<ProjectReference Include="..\OoBDev.Text.Json\OoBDev.Text.Json.csproj" />
		<ProjectReference Include="..\OoBDev.ToolKit\OoBDev.ToolKit.csproj" />
		<ProjectReference Include="..\OoBDev.Yaml\OoBDev.Yaml.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="GitVersion.MsBuild" Version="6.1.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

</Project>
