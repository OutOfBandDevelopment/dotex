		<ProjectReference Include="..\OoBDev.IdentityModel.Extensions\OoBDev.IdentityModel.Extensions.csproj" />
		<ProjectReference Include="..\OoBDev.MessageQueueing\OoBDev.MessageQueueing.csproj" />
		<ProjectReference Include="..\OoBDev.TestUtilities\OoBDev.TestUtilities.csproj" />
