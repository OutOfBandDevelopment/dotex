<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UiDefinitions controls: Blazor</title>
    <HeadOutlet @rendermode="InteractiveServer" />
    <style>
        body { font-family: Segoe UI, sans-serif; margin: 24px auto; max-width: 1000px; color: #1f2933; background: #fff; }
        .lede { color: #52606d; }
        .layout { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; align-items: start; }
        fieldset.uidef-section { margin: 0 0 12px; border: 1px solid #cbd2d9; border-radius: 6px; }
        .preview, .readout { border: 1px solid #cbd2d9; border-radius: 6px; padding: 8px 16px; margin-bottom: 16px; }
        .preview.off { opacity: .45; }
        .preview .title { font-size: 1.4em; font-weight: 600; margin: 4px 0; }
        .badge { padding: 2px 10px; border-radius: 10px; color: #fff; }
        .mode-low { background: #2f855a; }
        .mode-medium { background: #b7791f; }
        .mode-high { background: #c53030; }
        .bar { height: 10px; background: #e4e7eb; border-radius: 5px; overflow: hidden; }
        .bar .fill { height: 100%; background: #3182ce; }
        .dots { color: #3182ce; letter-spacing: 1px; }
        .readout table { width: 100%; border-collapse: collapse; }
        .readout th { text-align: left; font-weight: 500; color: #52606d; width: 40%; }
        .readout td, .readout th { padding: 2px 4px; border-bottom: 1px solid #e4e7eb; }
    </style>
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
