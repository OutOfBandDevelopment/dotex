<Project>

  <Target Name="GenerateDacPac"
         AfterTargets="Build"
         Condition="'$(IsSqlClr)' == 'true' AND '$(TargetFramework)' != '' AND '$(TargetPath)' != ''">
    <Message Text="Generating DACPAC from SQL CLR assembly..." Importance="High" />

    <!-- Define properties at target execution time when build paths are available -->
    <!-- Projects can override these by setting them in a PropertyGroup -->
    <PropertyGroup>
      <SqlAssemblyFileFramework Condition="'$(SqlAssemblyFileFramework)' == ''">$(TargetPath)</SqlAssemblyFileFramework>
      <SqlAssemblyDacPacFile Condition="'$(SqlAssemblyDacPacFile)' == ''">$([System.IO.Path]::GetDirectoryName('$(TargetPath)'))\$(AssemblyName).dacpac</SqlAssemblyDacPacFile>
    </PropertyGroup>

    <!-- Fail if DLL does not exist yet -->
    <Error Condition="!Exists('$(TargetPath)')" Text="Primary DLL not found: $(TargetPath)" />

    <Message Text="TargetPath: $(TargetPath)" Importance="High" />
    <Message Text="SqlAssemblyFileFramework: $(SqlAssemblyFileFramework)" Importance="High" />
    <Message Text="SqlAssemblyDacPacFile: $(SqlAssemblyDacPacFile)" Importance="High" />

    <Exec Command="dotnet run --project &quot;$(SolutionDir)Tools/OoBDev.DacPacCompiler.Cli&quot; --sqlclr &quot;$(SqlAssemblyFileFramework)&quot; --dacpac &quot;$(SqlAssemblyDacPacFile)&quot; --version &quot;$(AssemblyVersion)&quot;"
          ContinueOnError="false"
          StandardErrorImportance="High"
          StandardOutputImportance="High" />

    <!-- Verify the DACPAC was created successfully -->
    <Error Condition="!Exists('$(SqlAssemblyDacPacFile)')" Text="DACPAC generation failed: $(SqlAssemblyDacPacFile) does not exist" />

    <Message Text="DACPAC generated: $(SqlAssemblyDacPacFile)" Importance="High" />

    <!-- Register the DACPAC as a build output so consuming projects can reference it -->
    <ItemGroup>
      <FileWrites Include="$(SqlAssemblyDacPacFile)" />
    </ItemGroup>
  </Target>

</Project>