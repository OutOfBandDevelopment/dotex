<Window x:Class="DevTermApp.InstrumentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="360" Width="360" MinHeight="240" MinWidth="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Select" Width="80" Height="32" Margin="0,0,8,0" IsDefault="True" Click="Select_Click" />
            <Button Content="Cancel" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex}" MouseDoubleClick="List_MouseDoubleClick" />
    </DockPanel>
</Window>
