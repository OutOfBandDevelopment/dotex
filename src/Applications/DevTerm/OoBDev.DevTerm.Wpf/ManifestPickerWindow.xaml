<Window x:Class="DevTermApp.ManifestPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open device manifest" Height="400" Width="520" MinHeight="320" MinWidth="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox Grid.Row="0" ItemsSource="{Binding Entries}" SelectedIndex="{Binding SelectedIndex}" DisplayMemberPath="DisplayName" MouseDoubleClick="List_MouseDoubleClick" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Or a path (file, folder, .zip):" />
        <DockPanel Grid.Row="2" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Folder..." Width="72" Margin="6,0,0,0" Click="BrowseFolder_Click" />
            <Button DockPanel.Dock="Right" Content="File..." Width="72" Margin="6,0,0,0" Click="BrowseFile_Click" />
            <TextBox Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="A manifest file (.json), a folder with a device.json, or a .zip of one" />
        </DockPanel>
        <ScrollViewer Grid.Row="3" MaxHeight="72" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock TextWrapping="Wrap" Foreground="#C0392B" Text="{Binding Error}" />
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open" Width="80" Height="32" Margin="0,0,8,0" IsDefault="True" Click="Open_Click" />
            <Button Content="Cancel" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
