<Window x:Class="DevTermApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UiDefinitionsWpf;assembly=OoBDev.UiDefinitions.Wpf"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        Title="OoBDev DevTerm" Width="900" Height="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New connection..." Command="{Binding NewConnection}" />
                <MenuItem Header="New _loopback session" Command="{Binding NewLoopbackSession}" />
                <MenuItem Header="Listen for _peers..." Command="{Binding ListenForPeers}" />
                <MenuItem Header="Listen for _UDP..." Command="{Binding ListenForUdp}" />
                <MenuItem Header="Open log for _playback..." Command="{Binding OpenPlaybackWindow}" />
                <Separator />
                <MenuItem Header="Start _logging" Command="{Binding SelectedSession.ToggleLogging}" />
                <MenuItem Header="Add _note to log..." Command="{Binding SelectedSession.AddLogNote}" />
            </MenuItem>
            <MenuItem Header="_Device">
                <MenuItem Header="Device _manifest..." Command="{Binding OpenManifestPanel}" />
                <MenuItem Header="_Edit device manifest..." Command="{Binding ShowManifestEditor}" />
                <Separator />
                <MenuItem Header="S_tream monitor..." Command="{Binding ShowStreamMonitorWindow}" />
                <MenuItem Header="_Routing..." Command="{Binding ShowRoutingWindow}" />
                <MenuItem Header="Converter _tools..." Command="{Binding ShowConverterTools}" />
                <MenuItem Header="Confi_gure device..." Command="{Binding ShowConfigureDevice}" />
                <MenuItem Header="_Install plugin..." Command="{Binding InstallPluginFromZip}" />
                <MenuItem Header="_Plugins..." Command="{Binding ShowPlugins}" />
                <MenuItem Header="_Plugin approvals..." Command="{Binding ReviewPluginApprovals}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Theme" ItemsSource="{Binding Themes.Choices}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                            <Setter Property="Command" Value="{Binding Select}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Build or edit theme..." Command="{Binding BuildTheme}" />
                <MenuItem Header="_All sessions log..." Command="{Binding ShowMergedLogWindow}" />
                <Separator />
                <MenuItem Header="_Echo sent commands" IsCheckable="True" IsChecked="{Binding SelectedSession.EchoSent, Mode=TwoWay}" />
                <MenuItem Header="_Software flow control (XON/XOFF)" IsCheckable="True" IsEnabled="{Binding SelectedSession.HasSoftwareFlowControl}" IsChecked="{Binding SelectedSession.SoftwareFlowControl, Mode=TwoWay}" />
                <MenuItem Header="Clea_r output" Command="{Binding SelectedSession.ClearOutput}" />
            </MenuItem>
        </Menu>
        <Grid DockPanel.Dock="Bottom" DataContext="{Binding SelectedSession}" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox AutomationProperties.Name="Text to send" Grid.Column="0" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Send" Margin="4,0,0,0" Command="{Binding Send}" />
            <Button Grid.Column="2" Content="Connect" Margin="4,0,0,0" Command="{Binding Connect}" />
            <Button Grid.Column="3" Content="Disconnect" Margin="4,0,0,0" Command="{Binding Disconnect}" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox Content="Echo sent commands" IsChecked="{Binding EchoSent}" VerticalAlignment="Center" />
                <Button Content="Clear output" Margin="8,0,0,0" Padding="8,0" Command="{Binding ClearOutput}" />
                <ToggleButton Content="Log to file" Margin="8,0,0,0" Padding="8,0" IsChecked="{Binding IsLogging, Mode=OneWay}" Command="{Binding ToggleLogging}" ToolTip="{Binding LogPath}" />
                <Button Content="Add note" Margin="8,0,0,0" Padding="8,0" Command="{Binding AddLogNote}" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" DataContext="{Binding SelectedSession}" Text="{Binding ErrorMessage}" Foreground="Firebrick" Margin="4" />
        <avalon:DockingManager x:Name="Dock">
            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Horizontal">
                    <avalon:LayoutAnchorablePane DockWidth="220">
                        <avalon:LayoutAnchorable ContentId="commands" Title="Commands" CanClose="False" CanFloat="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Button Content="New connection..." Margin="4" Command="{Binding NewConnection}" />
                                        <Button Content="Open log for playback..." Margin="4" Command="{Binding OpenPlaybackWindow}" />
                                        <Button Content="Merged log..." Margin="4" Command="{Binding ShowMergedLogWindow}" />
                                        <Button Content="Stream monitor..." Margin="4" Command="{Binding ShowStreamMonitorWindow}" />
                                        <Button Content="Routing..." Margin="4" Command="{Binding ShowRoutingWindow}" />
                                        <Button Content="Device manifest..." Margin="4" Command="{Binding OpenManifestPanel}" />
                                        <Button Content="Edit manifest..." Margin="4" Command="{Binding ShowManifestEditor}" />
                                        <Button Content="Build theme..." Margin="4" Command="{Binding BuildTheme}" />
                                        <Button Content="Configure device..." Margin="4" Command="{Binding ShowConfigureDevice}" />
                                        <Button Content="Converter tools..." Margin="4" Command="{Binding ShowConverterTools}" />
                                        <Button Content="New loopback session" Margin="4" Command="{Binding NewLoopbackSession}" />
                                        <ItemsControl ItemsSource="{Binding ProfileNames}" Margin="4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Command="{Binding DataContext.OpenProfileSession, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Theme" Margin="4,4,4,0" />
                                        <ComboBox AutomationProperties.Name="Theme" ItemsSource="{Binding Themes.Names}" SelectedItem="{Binding Themes.Selected}" Margin="4" />
                                        <ListBox AutomationProperties.Name="Sessions" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Title" Margin="4" MinHeight="60" />
                                        <ItemsControl ItemsSource="{Binding DevicePanels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding MenuTitle}" Margin="4"
                                                            Command="{Binding DataContext.OpenDevicePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Instruments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding MenuTitle}" Margin="4"
                                                            Command="{Binding DataContext.OpenInstrumentPanel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Factories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Title}" Margin="4"
                                                            Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </ScrollViewer>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                    <avalon:LayoutDocumentPane>
                        <avalon:LayoutDocument ContentId="output" Title="Session output" CanClose="False">
                        <ListBox AutomationProperties.Name="Session output" DataContext="{Binding DataContext.SelectedSession, RelativeSource={RelativeSource AncestorType=Window}}" ItemsSource="{Binding OutputLines}" FontFamily="Consolas" />
                                    </avalon:LayoutDocument>
                    </avalon:LayoutDocumentPane>
                    <avalon:LayoutAnchorablePane DockWidth="420">
                        <avalon:LayoutAnchorable ContentId="device" Title="Device panel" CanClose="False" CanFloat="True">
                            <ScrollViewer DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedPanel.Displays}" Margin="12,12,12,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:LiveDisplayView Margin="0,0,0,8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:FormView DataContext="{Binding SelectedPanel.Form}" Margin="12" />
                                </StackPanel>
                            </ScrollViewer>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>
    </DockPanel>
</Window>
