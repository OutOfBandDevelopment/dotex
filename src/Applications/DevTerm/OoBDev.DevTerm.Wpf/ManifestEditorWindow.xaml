<Window x:Class="DevTermApp.ManifestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UiDefinitionsWpf;assembly=OoBDev.UiDefinitions.Wpf"
        Title="{Binding Title}" Height="640" Width="1100" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0">
            <Button Content="New" Command="{Binding New}" Margin="2" Padding="8,3" />
            <Button Content="Open..." Command="{Binding Open}" Margin="2" Padding="8,3" />
            <Button Content="Save" Command="{Binding Save}" Margin="2" Padding="8,3" />
            <Button Content="Save as..." Command="{Binding SaveAs}" Margin="2" Padding="8,3" />
            <Button Content="Check" Command="{Binding Check}" Margin="2" Padding="8,3" />
            <Button Content="Undo" Command="{Binding Undo}" Margin="12,2,2,2" Padding="8,3" />
            <Button Content="Redo" Command="{Binding Redo}" Margin="2" Padding="8,3" />
            <Button Content="Import .ksy..." Command="{Binding ImportKsy}" Margin="12,2,2,2" Padding="8,3" />
            <Button Content="{Binding RecordingLabel}" Command="{Binding ToggleRecording}" Margin="2" Padding="8,3" />
            <Button Content="Panel to JSON" Command="{Binding ConvertPanelToJson}" ToolTip="Save the .xml panel file as JSON" Margin="2" Padding="8,3" />
        </WrapPanel>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <Button Content="{Binding AddLabel}" Command="{Binding Add}" Margin="2" Padding="8,3" />
                    <Button Content="Remove" Command="{Binding Remove}" Margin="2" Padding="8,3" />
                    <Button Content="Up" Command="{Binding MoveUp}" Margin="2" Padding="8,3" />
                    <Button Content="Down" Command="{Binding MoveDown}" Margin="2" Padding="8,3" />
                </WrapPanel>
                <ListBox ItemsSource="{Binding Nodes}" SelectedIndex="{Binding SelectedIndex}" DisplayMemberPath="Display" FontFamily="Consolas" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{Binding PaneTitle}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Text="{Binding Hint}" Margin="0,0,0,4" />
                <Button DockPanel.Dock="Bottom" Content="Create panel from commands" Command="{Binding CreatePanel}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,3" />
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding FieldPickers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label, StringFormat='Pick {0}...'}" Command="{Binding Pick}" Margin="0,4,4,0" Padding="8,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Text="{Binding Readouts}" FontFamily="Consolas" Margin="0,4,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ui:FormView DataContext="{Binding Form}" />
                </ScrollViewer>
            </DockPanel>
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Preview (nothing is sent)" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Text="{Binding PreviewSent}" Margin="0,4,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ui:FormView DataContext="{Binding Preview}" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
    </Grid>
</Window>
