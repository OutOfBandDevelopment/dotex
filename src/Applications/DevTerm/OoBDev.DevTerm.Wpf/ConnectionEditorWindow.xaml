<Window x:Class="DevTermApp.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection" Width="600" Height="640" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate x:Key="OptionDisplay">
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" />
        </DataTemplate>
        <DataTemplate x:Key="TextDisplay">
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Text="Saved profiles" FontWeight="SemiBold" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button Content="Load" Command="{Binding LoadCommand}" Margin="0,0,0,4" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,0,4" />
                <Button Content="Delete selected" Command="{Binding DeleteSelectedProfilesCommand}" Margin="0,0,0,4" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,0,4" />
                <Button Content="Export selected" Command="{Binding ExportSelectedProfilesCommand}" Margin="0,0,0,4" />
                <Button Content="Export all" Command="{Binding ExportAllProfilesCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileName}" SelectionMode="Extended" SelectionChanged="ProfilesList_SelectionChanged" />
        </DockPanel>
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Save as profile" Command="{Binding SaveCommand}" Margin="4,0" Padding="8,2" />
                <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="4,0" Padding="8,2" IsDefault="True" />
                <Button Content="Cancel" IsCancel="True" Margin="4,0" Padding="8,2" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Save as profile named" />
                <TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                <TextBlock Text="Import or export zip path" />
                <DockPanel Margin="0,2,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Browse..." Command="{Binding ZipBrowser.Browse, RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,2" Margin="4,0,0,0" />
                        <Button Content="Save as..." Command="{Binding ZipBrowser.SaveAs, RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,2" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBox Text="{Binding ImportExportPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Import" Command="{Binding ImportCommand}" Padding="8,2" Margin="0,0,4,0" />
                    <Button Content="Replace all from zip" Command="{Binding ReplaceAllFromZipCommand}" Padding="8,2" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Transport" />
                <ComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding Transport}" Margin="0,2,0,8" />
                <StackPanel Visibility="{Binding IsSerialLikeTransport, Converter={StaticResource Visible}}">
                    <TextBlock Text="Detected ports" />
                    <ComboBox ItemsSource="{Binding SerialPortNames}" SelectedItem="{Binding SelectedSerialPort}" ItemTemplate="{StaticResource TextDisplay}" Margin="0,2,0,8" />
                    <TextBlock Text="Serial port" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Baud" />
                    <TextBox Text="{Binding Baud, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Data bits" />
                    <TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Parity" />
                    <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding ParityText}" Margin="0,2,0,8" />
                    <TextBlock Text="Stop bits" />
                    <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBitsText}" Margin="0,2,0,8" />
                    <TextBlock Text="Flow control" />
                    <ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding HandshakeText}" Margin="0,2,0,8" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsTcpLikeTransport, Converter={StaticResource Visible}}">
                    <Button Content="Scan network" Command="{Binding Scans.ScanLxi, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,4" />
                    <TextBlock Text="Detected network devices" />
                    <ComboBox ItemsSource="{Binding LxiDeviceOptions}" SelectedItem="{Binding SelectedLxiDevice}" ItemTemplate="{StaticResource OptionDisplay}" Margin="0,2,0,8" />
                    <TextBlock Text="Host" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="TCP port" />
                    <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsUsbDeviceTransport, Converter={StaticResource Visible}}">
                    <TextBlock Text="Detected HID devices" Visibility="{Binding IsHidTransport, Converter={StaticResource Visible}}" />
                    <ComboBox ItemsSource="{Binding HidDeviceOptions}" SelectedItem="{Binding SelectedHidDevice}" ItemTemplate="{StaticResource OptionDisplay}" Margin="0,2,0,8" Visibility="{Binding IsHidTransport, Converter={StaticResource Visible}}" />
                    <TextBlock Text="Detected USBTMC devices" Visibility="{Binding IsUsbtmcTransport, Converter={StaticResource Visible}}" />
                    <ComboBox ItemsSource="{Binding UsbtmcDeviceOptions}" SelectedItem="{Binding SelectedUsbtmcDevice}" ItemTemplate="{StaticResource OptionDisplay}" Margin="0,2,0,8" Visibility="{Binding IsUsbtmcTransport, Converter={StaticResource Visible}}" />
                    <TextBlock Text="Vendor id" />
                    <TextBox Text="{Binding VendorId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Product id" />
                    <TextBox Text="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Serial number" />
                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Device path" />
                    <TextBox Text="{Binding DevicePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsBleTransport, Converter={StaticResource Visible}}">
                    <Button Content="Scan Bluetooth" Command="{Binding Scans.ScanBle, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,4" />
                    <TextBlock Text="Detected BLE devices" />
                    <ComboBox ItemsSource="{Binding BleDeviceOptions}" SelectedItem="{Binding SelectedBleDevice}" ItemTemplate="{StaticResource OptionDisplay}" Margin="0,2,0,8" />
                    <TextBlock Text="Device id" />
                    <TextBox Text="{Binding BleDeviceId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <Button Content="Explore characteristics" Command="{Binding Scans.ExploreBle, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,4" />
                    <TextBlock Text="Detected characteristics (write)" />
                    <ComboBox ItemsSource="{Binding BleCharacteristicOptions}" SelectedItem="{Binding SelectedBleWriteCharacteristic}" ItemTemplate="{StaticResource OptionDisplay}" Margin="0,2,0,8" />
                    <TextBlock Text="Detected characteristics (notify)" />
                    <ComboBox ItemsSource="{Binding BleCharacteristicOptions}" SelectedItem="{Binding SelectedBleNotifyCharacteristic}" ItemTemplate="{StaticResource OptionDisplay}" Margin="0,2,0,8" />
                    <TextBlock Text="Service uuid" />
                    <TextBox Text="{Binding BleServiceUuid, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Write characteristic uuid" />
                    <TextBox Text="{Binding BleWriteCharacteristicUuid, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Notify characteristic uuid" />
                    <TextBox Text="{Binding BleNotifyCharacteristicUuid, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsMqttTransport, Converter={StaticResource Visible}}">
                    <TextBlock Text="User name" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
