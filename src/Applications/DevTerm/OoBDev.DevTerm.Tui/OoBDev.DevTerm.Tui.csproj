<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>false</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MA0016;MA0023;MA0051;MA0004;MA0048;MA0002;MA0009;CA1859;CA1829;OOB0001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\OoBDev.DevTerm.Core\OoBDev.DevTerm.Core.csproj" />
		<ProjectReference Include="..\OoBDev.DevTerm.Devices\OoBDev.DevTerm.Devices.csproj" />
		<ProjectReference Include="..\..\..\Framework\OoBDev.UiDefinitions.Tui\OoBDev.UiDefinitions.Tui.csproj" />
		<ProjectReference Include="..\..\..\Framework\OoBDev.System.IO.Ports\OoBDev.System.IO.Ports.csproj" />
		<ProjectReference Include="..\..\..\Framework\OoBDev.System.IO.UsbHids\OoBDev.System.IO.UsbHids.csproj" />
		<ProjectReference Include="..\..\..\Framework\OoBDev.System.IO.UsbTmc\OoBDev.System.IO.UsbTmc.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Terminal.Gui" />
		<PackageReference Include="Terminal.Gui.Editor" />
		<PackageReference Include="GitVersion.MsBuild">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="OoBDev.DevTerm.Tui.Tests" />
	</ItemGroup>

	<!-- The Windows BLE backend targets a Windows TFM, so a plain net10.0 app cannot reference it; BlePlatformAdapterLoader
	     loads it next to the app. Publish (not Build) is what brings its WinRT dependency closure along. -->
	<Target Name="CopyWindowsBleBackend" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
		<MSBuild Projects="..\..\..\Framework\OoBDev.System.IO.Bluetooth.Windows\OoBDev.System.IO.Bluetooth.Windows.csproj"
		         Targets="Publish"
		         Properties="Configuration=$(Configuration)" />
		<ItemGroup>
			<_BleWindowsBackendOutput Include="..\..\..\Framework\OoBDev.System.IO.Bluetooth.Windows\bin\$(Configuration)\**\publish\*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_BleWindowsBackendOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
