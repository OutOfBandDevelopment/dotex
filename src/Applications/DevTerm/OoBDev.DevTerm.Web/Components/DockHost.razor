@page "/dock"
@using OoBDev.DevTerm.Web.Docking
@inject DockLayoutStore Store

<h2>Dock</h2>
<style>
    .dock-root { height: 80vh; display: flex; }
    .dock-split { display: flex; flex: 1; min-width: 0; min-height: 0; gap: 4px; }
    .dock-cell { min-width: 0; min-height: 0; display: flex; }
    .dock-cell > * { flex: 1; }
    .dock-pane { display: flex; flex-direction: column; flex: 1; min-width: 0; border: 1px solid #38424f; }
    .dock-tabs { display: flex; flex-wrap: wrap; background: #1c232b; }
    .dock-tab { display: inline-flex; border-right: 1px solid #38424f; }
    .dock-tab[aria-selected=true] { background: #2a3440; }
    .dock-splitter { display: flex; flex-direction: column; justify-content: center; }
    .dock-drops { display: flex; gap: 2px; font-size: 11px; }
    .dock-drop { flex: 1; text-align: center; border: 1px dashed #38424f; color: #8a96a3; }
    .dock-body { overflow: auto; padding: 8px; flex: 1; }
</style>
@if (_layout is null)
{
    <p class="note">Loading layout...</p>
}
else
{
    <div class="dock-root" data-dock>
        <DockNodeView Node="_layout.Root" Layout="_layout" Events="_events" />
    </div>
    <p><button type="button" @onclick="ResetAsync">Reset layout</button> <button type="button" data-export @onclick="ExportLayout">Export</button> <button type="button" data-import @onclick="ImportAsync">Import</button></p>
    <textarea rows="6" aria-label="Layout JSON" data-layout-json @bind="_text"></textarea>
    @if (_note is not null) { <p class="note" data-note>@_note</p> }
}

@code {
    private DockLayout? _layout;
    private string? _dragging;
    private string _text = "";
    private string? _note;

    private void ExportLayout() { _text = _layout!.ToJson(); _note = "Layout exported to the box."; }

    private async Task ImportAsync()
    {
        var loaded = DockLayout.Load(_text, Ids);
        _note = loaded.ToJson() == DockLayout.Default(Ids).ToJson() && _text.Trim() != _layout!.ToJson() ? "Not a valid layout; the default was applied." : "Layout imported.";
        await ChangeAsync(loaded);
    }
    private DockEvents _events = default!;

    protected override void OnInitialized() => _events = new DockEvents(
        id => Apply(l => l.Activate(id)),
        id => Apply(l => l.Close(id)),
        id => _dragging = id,
        Drop,
        Resize);

    private void Drop(DockPane pane, string? direction, bool before)
    {
        var id = _dragging;
        _dragging = null;
        if (id is null) { return; }
        Apply(l =>
        {
            var at = l.IndexOf(pane);
            if (at < 0) { return l; }
            return direction is null ? l.Move(id, at) : l.Split(id, at, direction, before);
        });
    }

    private void Resize(DockSplit split, int child, double delta) => Apply(l =>
    {
        var at = l.IndexOf(split);
        if (at < 0) { return l; }
        var ratios = split.Ratios.ToArray();
        ratios[child] += delta;
        ratios[child + 1] -= delta;
        return l.Resize(at, ratios);
    });

    private async void Apply(Func<DockLayout, DockLayout> change)
    {
        try
        {
            await ChangeAsync(change(_layout!));
            StateHasChanged();
        }
        catch (Exception)
        {
            // A closed circuit has nothing left to update.
        }
    }

    private static IReadOnlyCollection<string> Ids => [.. DockPanels.All.Select(p => p.Id)];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _layout = await Store.LoadAsync(Ids);
            StateHasChanged();
        }
    }


    private Task ResetAsync() => ChangeAsync(DockLayout.Default(Ids));

    private async Task ChangeAsync(DockLayout next)
    {
        _layout = next;
        await Store.SaveAsync(next);
    }
}
