<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MA0016;MA0023;MA0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OoBDev.DevTerm.Core\OoBDev.DevTerm.Core.csproj" />
    <ProjectReference Include="..\OoBDev.DevTerm.Devices\OoBDev.DevTerm.Devices.csproj" />
    <ProjectReference Include="..\..\..\Framework\OoBDev.System.IO.Ports\OoBDev.System.IO.Ports.csproj" />
    <ProjectReference Include="..\..\..\Framework\OoBDev.System.IO.UsbHids\OoBDev.System.IO.UsbHids.csproj" />
    <ProjectReference Include="..\..\..\Framework\OoBDev.System.IO.UsbTmc\OoBDev.System.IO.UsbTmc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OoBDev.DevTerm.Web.Tests" />
  </ItemGroup>

  <Target Name="CopyWindowsBleBackend" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <MSBuild Projects="..\..\..\Framework\OoBDev.System.IO.Bluetooth.Windows\OoBDev.System.IO.Bluetooth.Windows.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <_BleWindowsBackendOutput Include="..\..\..\Framework\OoBDev.System.IO.Bluetooth.Windows\bin\$(Configuration)\**\publish\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_BleWindowsBackendOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
