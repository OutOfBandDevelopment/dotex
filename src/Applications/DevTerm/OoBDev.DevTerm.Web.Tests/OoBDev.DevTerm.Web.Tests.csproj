<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>false</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="Microsoft.Playwright" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="coverlet.collector">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OoBDev.DevTerm.Web\OoBDev.DevTerm.Web.csproj" />
		<ProjectReference Include="..\..\..\Framework\OoBDev.TestUtilities\OoBDev.TestUtilities.csproj" />
		<ProjectReference Include="..\OoBDev.DevTerm.TestUtilities\OoBDev.DevTerm.TestUtilities.csproj" />
		<!-- Built first, not referenced as code: the flows load its output from plugins/demo like a real plugin. -->
		<ProjectReference Include="..\OoBDev.DevTerm.Devices.Demo\OoBDev.DevTerm.Devices.Demo.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<Target Name="CopyDemoPlugin" AfterTargets="Build">
		<ItemGroup>
			<DemoPluginFile Include="..\OoBDev.DevTerm.Devices.Demo\bin\$(Configuration)\net10.0\OoBDev.DevTerm.Devices.Demo.*" />
			<DemoPluginFile Include="..\OoBDev.DevTerm.Devices.Demo\bin\$(Configuration)\net10.0\plugin.json" />
		</ItemGroup>
		<Copy SourceFiles="@(DemoPluginFile)" DestinationFolder="$(OutDir)plugins\demo" />
	</Target>

</Project>
