<Window x:Class="DevTermApp.ConfigureDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OoBDev.DevTerm.Wpf"
        Title="Configure device" Height="560" Width="640" MinHeight="360" MinWidth="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ConfigTextFieldViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigToggleFieldViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}" HorizontalAlignment="Left" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigChoiceFieldViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Read from device" Width="130" Height="32" Margin="0,0,8,0" Command="{Binding Read}" />
            <Button Content="Write to device" Width="120" Height="32" Margin="0,0,8,0" Command="{Binding Write}" />
            <Button Content="Close" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Status}" />
        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Summary}" />
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Editor" Margin="0,0,10,6" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6" ItemsSource="{Binding Editors}" DisplayMemberPath="Title" SelectedIndex="{Binding SelectedEditorIndex}" />
            <TextBlock Grid.Row="1" Text="Host" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Port" Margin="10,0,6,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}" />
        </ScrollViewer>
    </DockPanel>
</Window>
