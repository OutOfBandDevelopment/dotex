<Window x:Class="DevTermApp.ThemeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme builder" Height="560" Width="620" MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Name:" VerticalAlignment="Center" />
            <TextBox Width="220" Margin="6,0,16,0" VerticalContentAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Chart palette:" VerticalAlignment="Center" />
            <ComboBox Width="90" Margin="6,0,0,0" VerticalContentAlignment="Center" ItemsSource="{Binding Palettes}" SelectedIndex="{Binding PaletteIndex}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="0,10,0,4" Text="Colors (double-click or Edit... to change; ● marks one overridden from the seed):" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" FontFamily="Consolas" ItemsSource="{Binding Roles}" SelectedIndex="{Binding SelectedRoleIndex}" DisplayMemberPath="Row" MouseDoubleClick="Roles_MouseDoubleClick" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Edit..." Width="110" Margin="0,0,0,6" Command="{Binding Edit}" />
                <Button Content="Reset to seed" Width="110" Command="{Binding Reset}" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#B9770E" Text="{Binding Warnings}" />
        <TextBlock Grid.Row="4" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#C0392B" Text="{Binding Error}" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Height="32" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Width="80" Height="32" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
