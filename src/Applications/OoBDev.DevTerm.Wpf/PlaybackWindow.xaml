<Window x:Class="DevTermApp.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playback" Width="720" Height="460" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Description}" Margin="0,0,0,4" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Rewind" Command="{Binding Rewind}" Padding="8,2" />
            <Button Content="Play/Pause" Command="{Binding PlayPause}" Margin="4,0" Padding="8,2" />
            <Button Content="Step" Command="{Binding Step}" Padding="8,2" />
            <Button Content="Fast forward" Command="{Binding FastForward}" Margin="4,0" Padding="8,2" />
            <Button Content="Skip to end" Command="{Binding SkipToEnd}" Padding="8,2" />
            <TextBlock Text="{Binding Position}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <Button Content="Close" IsCancel="True" Margin="12,0,0,0" Padding="8,2" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Lines}" FontFamily="Consolas" />
    </DockPanel>
</Window>
