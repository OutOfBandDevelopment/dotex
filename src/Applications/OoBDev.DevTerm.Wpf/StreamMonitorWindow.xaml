<Window x:Class="DevTermApp.StreamMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream monitor" Width="760" Height="440" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Start" Command="{Binding Start}" Padding="8,2" />
            <Button Content="Stop" Command="{Binding Stop}" Margin="4,0" Padding="8,2" />
            <Button Content="Export as..." Command="{Binding Export}" Margin="0,0,4,0" Padding="8,2" />
            <ComboBox ItemsSource="{Binding ConvertChoices}" SelectedIndex="{Binding ConvertIndex}" MinWidth="140" Margin="0,0,4,0" />
            <Button Content="Convert" Command="{Binding Convert}" Margin="0,0,4,0" Padding="8,2" />
            <Button Content="Open folder" Command="{Binding OpenFolder}" Margin="0,0,4,0" Padding="8,2" />
            <Button Content="Close" IsCancel="True" Padding="8,2" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding FolderText}" Margin="0,6,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ExportStatus}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search device, type, end state, file name or time" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                    <ComboBox ItemsSource="{Binding KindChoices}" SelectedIndex="{Binding KindIndex}" MinWidth="120" />
                    <ComboBox ItemsSource="{Binding SortChoices}" SelectedIndex="{Binding SortIndex}" MinWidth="90" Margin="4,0,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Captures}" SelectedIndex="{Binding SelectedIndex}" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Detail}" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding SavedPath}" TextWrapping="Wrap" Margin="0,2,0,6" />
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                    <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
