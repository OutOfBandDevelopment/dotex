<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework is Windows-only, conditionally target based on OS -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFrameworks>net48</TargetFrameworks>
  </PropertyGroup>

  <!-- On non-Windows platforms, target a cross-platform framework as fallback -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFrameworks>netstandard2.1</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>

    <IsSqlClr>True</IsSqlClr>
    <AssemblyName>OoBDev.Data.Vectors</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>

    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageReadmeFile>README.md</PackageReadmeFile>

  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OoBDev.Data.Vectors\**\*.cs" Exclude="..\OoBDev.Data.Vectors\bin\**;..\OoBDev.Data.Vectors\obj\**" />
  </ItemGroup>

  <!-- SQLCLR dependencies only needed for .NET Framework build -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <!-- Build the DacPacCompiler.Cli tool before generating DACPAC -->
  <PropertyGroup>
    <DacPacToolProject>$(MSBuildThisFileDirectory)..\..\Tools\OoBDev.DacPacCompiler.Cli\OoBDev.DacPacCompiler.Cli.csproj</DacPacToolProject>
  </PropertyGroup>

  <Target Name="BuildDacPacTool" BeforeTargets="GenerateDacPac">
    <Message Text="Building DacPacCompiler.Cli tool..." Importance="High" />
    <MSBuild Projects="$(DacPacToolProject)"
             Targets="Build"
             Properties="TargetFramework=net9.0" />
  </Target>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
