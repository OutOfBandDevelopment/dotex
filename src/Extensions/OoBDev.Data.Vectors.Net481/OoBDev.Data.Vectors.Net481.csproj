<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481</TargetFrameworks>
    <!--<TargetFrameworks>net481;netstandard2.1</TargetFrameworks>-->
    <LangVersion>preview</LangVersion>
    
    <IsSqlClr>True</IsSqlClr>
    <AssemblyName>OoBDev.Data.Vectors</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

  </PropertyGroup>

  <ItemGroup>
    <!-- Condition="'$(TargetFramework)' == 'net481'" -->
    
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OoBDev.Data.Vectors\**\*.cs"
             Exclude="..\OoBDev.Data.Vectors\bin\**;..\OoBDev.Data.Vectors\obj\**" />
  </ItemGroup>

  <!-- Build the DacPacCompiler.Cli tool before generating DACPAC -->
  <PropertyGroup>
    <DacPacToolProject>$(MSBuildThisFileDirectory)..\..\Tools\OoBDev.DacPacCompiler.Cli\OoBDev.DacPacCompiler.Cli.csproj</DacPacToolProject>
  </PropertyGroup>

  <Target Name="BuildDacPacTool" BeforeTargets="GenerateDacPac">
    <Message Text="Building DacPacCompiler.Cli tool..." Importance="High" />
    <MSBuild Projects="$(DacPacToolProject)" Targets="Build" />
  </Target>

</Project>
