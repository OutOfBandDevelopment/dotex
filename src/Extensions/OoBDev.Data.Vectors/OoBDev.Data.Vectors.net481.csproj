      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>-->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OoBDev.Data.Vectors.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ExampleScripts\" />
  </ItemGroup>

