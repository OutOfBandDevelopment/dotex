<UserControl x:Class="OoBDev.UiDefinitions.Wpf.ColorPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12" MinWidth="280">
        <Border Height="48" CornerRadius="4" BorderBrush="Gray" BorderThickness="1" Background="{Binding Preview}" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="R" Grid.Row="0" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}" Margin="0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Red}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Text="G" Grid.Row="1" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Text="B" Grid.Row="2" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Command="{Binding Accept}" IsDefault="True" MinWidth="72" Margin="0,0,8,0" />
            <Button Content="Cancel" Command="{Binding Cancel}" IsCancel="True" MinWidth="72" />
        </StackPanel>
    </StackPanel>
</UserControl>
