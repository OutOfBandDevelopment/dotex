<UserControl x:Class="OoBDev.UiDefinitions.Wpf.FormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OoBDev.UiDefinitions.ViewModels;assembly=OoBDev.UiDefinitions.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="OptionRadio" DataType="{x:Type vm:ChoiceOptionViewModel}">
            <RadioButton GroupName="{Binding DataContext.Id, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Text}"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding Command}"
                         CommandParameter="{Binding Text}"
                         Margin="0,0,12,0" />
        </DataTemplate>

        <DataTemplate x:Key="OptionCheck" DataType="{x:Type vm:ChoiceOptionViewModel}">
            <CheckBox Content="{Binding Text}"
                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                      Command="{Binding Command}"
                      CommandParameter="{Binding Text}"
                      Margin="0,0,12,0" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToggleViewModel}">
            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding Toggle}"
                      ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextViewModel}">
            <StackPanel>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsEnabled}"
                         ToolTip="{Binding Description}" />
                <TextBlock Text="{Binding Error}" Foreground="Firebrick" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChoiceViewModel}">
            <ItemsControl ItemsSource="{Binding OptionItems}"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip="{Binding Description}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource OptionRadio}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Style}" Value="CheckList">
                                <Setter Property="ItemTemplate" Value="{StaticResource OptionCheck}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ButtonViewModel}">
            <Button Content="{Binding Label}"
                    Command="{Binding Invoke}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding Description}"
                    HorizontalAlignment="Left" />
        </DataTemplate>

        <DataTemplate x:Key="Row" DataType="{x:Type vm:ControlViewModel}">
            <Grid Margin="0,2" Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" Content="{Binding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FormSectionViewModel}">
            <GroupBox Header="{Binding Label}" Margin="0,0,0,8"
                      Visibility="{Binding HasVisibleRows, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Row}" />
            </GroupBox>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Sections}" />
    </ScrollViewer>
</UserControl>
