<UserControl x:Class="UiDefinitionsWpf.FormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OoBDev.UiDefinitions.ViewModels;assembly=OoBDev.UiDefinitions.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="OptionRadio" DataType="{x:Type vm:ChoiceOptionViewModel}">
            <RadioButton GroupName="{Binding DataContext.Id, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Text}"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding Command}"
                         CommandParameter="{Binding Text}"
                         Margin="0,0,12,0" />
        </DataTemplate>

        <DataTemplate x:Key="OptionCheck" DataType="{x:Type vm:ChoiceOptionViewModel}">
            <CheckBox Content="{Binding Text}"
                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                      Command="{Binding Command}"
                      CommandParameter="{Binding Text}"
                      Margin="0,0,12,0" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToggleViewModel}">
            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                      IsEnabled="{Binding IsEnabled}"
                      Command="{Binding Toggle}"
                      ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextViewModel}">
            <StackPanel>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsEnabled}"
                         ToolTip="{Binding Description}" />
                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        SmallChange="{Binding Step}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        Value="{Binding Value, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled}"
                        Visibility="{Binding IsSlider, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Error}" Foreground="Firebrick" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChoiceViewModel}">
            <ItemsControl ItemsSource="{Binding OptionItems}"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip="{Binding Description}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource OptionRadio}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Style}" Value="CheckList">
                                <Setter Property="ItemTemplate" Value="{StaticResource OptionCheck}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding UsesDropdown}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ComboBox ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding PickedOption}"
                                                      HorizontalAlignment="Left"
                                                      MinWidth="200" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:IndicatorViewModel}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Description}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="Firebrick" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ListViewModel}">
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     IsEnabled="{Binding IsEnabled}"
                     ToolTip="{Binding Description}"
                     MinHeight="80" MaxHeight="160" MaxWidth="320" HorizontalAlignment="Left" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ButtonViewModel}">
            <Button Content="{Binding Label}"
                    Command="{Binding Invoke}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding ToolTip}"
                    HorizontalAlignment="Left" />
        </DataTemplate>

        <DataTemplate x:Key="Row" DataType="{x:Type vm:ControlViewModel}">
            <Grid Margin="0,2" Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" Content="{Binding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FormSectionViewModel}">
            <GroupBox Header="{Binding Label}" Margin="0,0,0,8"
                      Visibility="{Binding HasVisibleRows, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Row}" />
            </GroupBox>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Sections}" />
            <Expander Header="Notes" IsExpanded="{Binding NotesExpanded, Mode=TwoWay}" Margin="0,0,0,8"
                      Visibility="{Binding HasNotes, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="12,4,4,2" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
