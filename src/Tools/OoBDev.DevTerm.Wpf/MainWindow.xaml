<Window x:Class="DevTermApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OoBDev.UiDefinitions.Wpf;assembly=OoBDev.UiDefinitions.Wpf"
        Title="OoBDev DevTerm" Width="900" Height="600">
    <DockPanel>
        <ItemsControl DockPanel.Dock="Left" Width="180" ItemsSource="{Binding Factories}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Title}" Margin="4"
                            Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ui:FormView DataContext="{Binding SelectedPanel.Form}" Margin="12" />
        </ScrollViewer>
    </DockPanel>
</Window>
