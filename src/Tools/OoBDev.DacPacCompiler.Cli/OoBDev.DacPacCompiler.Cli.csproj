<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dacpactools</ToolCommandName>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="6.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ExternalServices\Microsoft\OoBDev.Microsoft.SqlServer.DacFx\OoBDev.Microsoft.SqlServer.DacFx.csproj" />
    <ProjectReference Include="..\..\Framework\OoBDev.DacFx\OoBDev.DacFx.csproj" />
  </ItemGroup>

  <!-- Force the 4.8.1 build to run before this project for testing -->
  <PropertyGroup>
    <VectorProjectDir>$(MSBuildProjectDirectory)\..\..\Extensions\OoBDev.Data.Vectors.Net481</VectorProjectDir>
    <VectorOutputPath>$(VectorProjectDir)\bin\$(Configuration)\net481</VectorOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VectorProjectDir)\OoBDev.Data.Vectors.Net481.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Force the 4.8.1 build to run before this project for testing -->
</Project>
