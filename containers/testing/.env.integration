# OoBDev Integration Test Environment Configuration
# Environment variables for Docker-based integration testing
#
# Usage:
#   Local:  These values are used by docker-compose and can be overridden
#   CI/CD:  GitHub Actions sets these as environment variables for tests
#
# Security Note: These are TEST credentials only. Never use in production!

# ============================================================================
# Docker Compose Configuration
# ============================================================================

COMPOSE_PROJECT_NAME=oobd-integration-tests

# ============================================================================
# SQL Server Configuration
# ============================================================================

SQL_SA_PASSWORD=IntegrationTest123!
MSSQL_PID=Developer

# Connection string for .NET tests
SQL_CONNECTION_STRING="Server=127.0.0.1,1433;User Id=sa;Password=IntegrationTest123!;TrustServerCertificate=True;Encrypt=False"

# ============================================================================
# MongoDB Configuration
# ============================================================================

# Connection string for .NET tests
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017

# Optional: Authentication (disabled for integration tests)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=IntegrationTest123!

# ============================================================================
# RabbitMQ Configuration
# ============================================================================

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Connection string for .NET tests
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@127.0.0.1:5673/
RABBITMQ_STOMP_PORT=21613

# ============================================================================
# OpenSearch Configuration
# ============================================================================

OPENSEARCH_PASSWORD=IntegrationTest123!
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# Connection string for .NET tests
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USERNAME=admin

# ============================================================================
# Qdrant Configuration
# ============================================================================

# Connection string for .NET tests
QDRANT_URL=http://127.0.0.1:6333
QDRANT_GRPC_URL=http://127.0.0.1:6334

# Optional: API key (not needed for local testing)
# QDRANT_API_KEY=

# ============================================================================
# Neo4j Configuration
# ============================================================================

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=oobdev-test-pass

# ============================================================================
# Apache Tika Configuration
# ============================================================================

# Connection string for .NET tests
TIKA_URL=http://127.0.0.1:9998

# ============================================================================
# SMTP Configuration (smtp4dev)
# ============================================================================

SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_WEB_PORT=7777

# ============================================================================
# Azurite Configuration (Azure Storage Emulator)
# ============================================================================

AZURITE_BLOB_URL=http://127.0.0.1:10000
AZURITE_QUEUE_URL=http://127.0.0.1:10001
AZURITE_TABLE_URL=http://127.0.0.1:10002

# Standard Azurite connection string
AZURITE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1"

# ============================================================================
# Moto Configuration (AWS Emulator)
# ============================================================================

MOTO_URL=http://127.0.0.1:4566
MOTO_EDGE_PORT=4566

# AWS credentials (dummy values for Moto)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# Keycloak Configuration
# ============================================================================

KEYCLOAK_URL=http://127.0.0.1:8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Realm configuration
KEYCLOAK_REALM=local-dev
KEYCLOAK_CLIENT_ID=test-client

# ============================================================================
# SBert Configuration (Sentence Embeddings)
# ============================================================================

SBERT_URL=http://127.0.0.1:5080
SBERT_MODEL=sentence-transformers/all-mpnet-base-v2

# ============================================================================
# Ollama Configuration (LLM Inference)
# ============================================================================

OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11435
OLLAMA_MODEL=phi3
OLLAMA_EMBEDDING_MODEL=all-minilm

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_CONNECTION_STRING=127.0.0.1:6379
REDIS_PASSWORD=

# ============================================================================
# PostgreSQL (with the pgmq extension)
# ============================================================================

POSTGRES_CONNECTION_STRING=Host=127.0.0.1;Port=5434;Database=oobdev_test;Username=postgres;Password=IntegrationTest123!

# PostgreSQL with the pgvector extension
PGVECTOR_CONNECTION_STRING=Host=127.0.0.1;Port=5435;Database=oobdev_test;Username=postgres;Password=IntegrationTest123!

# Docling serve (document conversion and OCR)
DOCLING_URL=http://127.0.0.1:5001

# ClamAV (virus scanning over clamd INSTREAM)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# SonarQube Community (static analysis; the token is a user secret, never committed)
SONARQUBE_URL=http://127.0.0.1:9002

# ============================================================================
# Azure Service Bus Emulator Configuration
# ============================================================================

AZURE_SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://127.0.0.1;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true"

# ============================================================================
# OpenTelemetry (Aspire dashboard: OTLP receiver, traces, logs, metrics)
# ============================================================================

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_DASHBOARD_URL=http://127.0.0.1:18888
OTEL_DASHBOARD_API_KEY=oobdev-test-key

# ============================================================================
# Test Execution Configuration
# ============================================================================

# Test timeout in seconds
TEST_TIMEOUT=30

# Health check configuration
HEALTHCHECK_RETRIES=5
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s

# ============================================================================
# Optional: Override for CI/CD
# ============================================================================

# In GitHub Actions, some URLs may need to be 127.0.0.1 instead of 127.0.0.1
# Uncomment and adjust if needed:
# SQL_CONNECTION_STRING=Server=127.0.0.1,1433;User Id=sa;Password=IntegrationTest123!;TrustServerCertificate=True
# MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017
