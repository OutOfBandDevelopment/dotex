# OoBDev Integration Test Environment Configuration
# Environment variables for Docker-based integration testing
#
# Usage:
#   Local:  These values are used by docker-compose and can be overridden
#   CI/CD:  GitHub Actions sets these as environment variables for tests
#
# Security Note: These are TEST credentials only. Never use in production!

# ============================================================================
# Docker Compose Configuration
# ============================================================================

COMPOSE_PROJECT_NAME=oobd-integration-tests

# ============================================================================
# SQL Server Configuration
# ============================================================================

SQL_SA_PASSWORD=IntegrationTest123!
MSSQL_PID=Developer

# Connection string for .NET tests
SQL_CONNECTION_STRING=Server=localhost,1433;User Id=sa;Password=IntegrationTest123!;TrustServerCertificate=True;Encrypt=False

# ============================================================================
# MongoDB Configuration
# ============================================================================

# Connection string for .NET tests
MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# Optional: Authentication (disabled for integration tests)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=IntegrationTest123!

# ============================================================================
# RabbitMQ Configuration
# ============================================================================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Connection string for .NET tests
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@localhost:5673/

# ============================================================================
# OpenSearch Configuration
# ============================================================================

OPENSEARCH_PASSWORD=IntegrationTest123!
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Connection string for .NET tests
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin

# ============================================================================
# Qdrant Configuration
# ============================================================================

# Connection string for .NET tests
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334

# Optional: API key (not needed for local testing)
# QDRANT_API_KEY=

# ============================================================================
# Apache Tika Configuration
# ============================================================================

# Connection string for .NET tests
TIKA_URL=http://localhost:9998

# ============================================================================
# SMTP Configuration (smtp4dev)
# ============================================================================

SMTP_HOST=localhost
SMTP_PORT=25
SMTP_WEB_PORT=7777

# ============================================================================
# Azurite Configuration (Azure Storage Emulator)
# ============================================================================

AZURITE_BLOB_URL=http://localhost:10000
AZURITE_QUEUE_URL=http://localhost:10001
AZURITE_TABLE_URL=http://localhost:10002

# Standard Azurite connection string
AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;TableEndpoint=http://localhost:10002/devstoreaccount1

# ============================================================================
# LocalStack Configuration (AWS Emulator)
# ============================================================================

LOCALSTACK_URL=http://localhost:4566
LOCALSTACK_EDGE_PORT=4566

# AWS credentials (dummy values for LocalStack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# Keycloak Configuration
# ============================================================================

KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Realm configuration
KEYCLOAK_REALM=local-dev
KEYCLOAK_CLIENT_ID=test-client

# ============================================================================
# SBert Configuration (Sentence Embeddings)
# ============================================================================

SBERT_URL=http://localhost:5080
SBERT_MODEL=sentence-transformers/all-mpnet-base-v2

# ============================================================================
# Ollama Configuration (LLM Inference)
# ============================================================================

OLLAMA_URL=http://localhost:11434
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=phi3

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_CONNECTION_STRING=localhost:6379
REDIS_PASSWORD=

# ============================================================================
# Azure Service Bus Emulator Configuration
# ============================================================================

AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true

# ============================================================================
# Azurinsight Configuration (Application Insights Emulator)
# ============================================================================

APPINSIGHTS_URL=http://localhost:5000
APPINSIGHTS_INSTRUMENTATION_KEY=test-key
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=test-key;IngestionEndpoint=http://localhost:5000

# ============================================================================
# Test Execution Configuration
# ============================================================================

# Test timeout in seconds
TEST_TIMEOUT=30

# Health check configuration
HEALTHCHECK_RETRIES=5
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s

# ============================================================================
# Optional: Override for CI/CD
# ============================================================================

# In GitHub Actions, some URLs may need to be 127.0.0.1 instead of localhost
# Uncomment and adjust if needed:
# SQL_CONNECTION_STRING=Server=127.0.0.1,1433;User Id=sa;Password=IntegrationTest123!;TrustServerCertificate=True
# MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017
